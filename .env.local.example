# ─── Copiar a tu máquina: `cp .env.local.example .env.local` y reemplazar valores ───

# Supabase → Project Settings → API
# Usá UNA de las dos claves públicas (anon JWT o publishable del dashboard nuevo).
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="pega_la_clave_anon_public"
# O en lugar de ANON_KEY:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase → Project Settings → Database → URI (marcá "Reveal" y poné la contraseña).
# Formato típico: postgresql://postgres.[ref]:[TU_PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres
# El seed Drizzle/pg usa DATABASE_URL para `pnpm seed:catalog`

# Alternativa recomendada si DATABASE_URL sigue fallando (28P01): variables explícitas
# SUPABASE_DB_HOST=aws-0-....pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_USER=postgres.TUREF
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_DATABASE=postgres

# Opcional — solo si algún script o servidor lo pide explícito (¡no exponer en el cliente!)
SUPABASE_SERVICE_ROLE_KEY="solo_backend_admin_opcional"

# Opcional — mapa en perfil
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# Opcional — Playwright E2E (auth.spec.ts)
# E2E_EMAIL="e2e@example.com"
# E2E_PASSWORD="..."
# E2E_USERNAME="e2euser"

# Opcional — script `pnpm seed:test-users`
# SEED_TEST_USER_PASSWORD="DevSeedStickr123!"
